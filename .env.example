# Read when the server starts (not baked into the build), so changing them only needs a restart.

# Base URL of the API.   main: https://api.islamijindegi.com   staging: https://api-test.islamijindegi.com
NEXT_PUBLIC_API_URL=https://api.islamijindegi.com
# Canonical origin of this site (sitemaps, canonical and Open Graph URLs).
NEXT_PUBLIC_SITE_URL=https://islamijindegi.com
# Google OAuth client id (admin sign-in).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Set to 1 on staging: robots.txt, sitemap and meta all go noindex.
NEXT_PUBLIC_NOINDEX=
# Set to 0 when the reverse proxy already compresses responses.
COMPRESS=1
